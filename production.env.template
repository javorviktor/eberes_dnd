# Production Environment Variables Template for VM Deployment
# Copy this to .env on the VM and set proper values

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/dnd?schema=public

# Security - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your_super_secure_jwt_secret_here_change_me

# API Configuration - Set this for production
NEXT_PUBLIC_API_URL=https://garagednd.botanyrobotics.com

# Node Environment
NODE_ENV=production

# For local development, use:
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NODE_ENV=development
